[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.1

[libraries]
macos.debug   = "res://gdext/target/debug/libstacktris.dylib"
macos.release = "res://gdext/target/release/libstacktris.dylib"
linux.debug.x86_64 = "res://gdext/target/x86_64-unknown-linux-gnu/debug/libstacktris.so"
linux.release.x86_64 = "res://gdext/target/x86_64-unknown-linux-gnu/release/libstacktris.so"
